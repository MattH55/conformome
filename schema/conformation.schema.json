{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://conformome.org/schema/conformation.schema.json",
  "title": "Conformation",
  "description": "A structural description of one conformation of a molecule, at one or more levels of resolution: secondary structure, folded and unfolded segments, contacts, coordinates, or a weighted ensemble. A conformation realises a curated state (state_id) or, for a prediction not yet matched to a state, stands alone (state_id null). Quantities derived from it (for example the contour length released on unfolding, which force spectroscopy measures) are stored with the method and parameters that produced them.",
  "type": "object",
  "required": [
    "conformation_id",
    "molecule_id",
    "state_id",
    "basis",
    "prediction",
    "method",
    "coverage",
    "representations",
    "derived",
    "assumptions",
    "status",
    "provenance"
  ],
  "additionalProperties": false,
  "properties": {
    "conformation_id": {
      "type": "string",
      "pattern": "^CF-[A-Za-z0-9_.-]+$"
    },
    "molecule_id": {
      "$ref": "common.schema.json#/$defs/molecule_id"
    },
    "state_id": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "common.schema.json#/$defs/state_id"
        }
      ]
    },
    "basis": {
      "$ref": "common.schema.json#/$defs/basis"
    },
    "prediction": {
      "type": "boolean",
      "description": "True when the conformation comes from a predictive model (AlphaFold, an ensemble generator, MD), whatever its basis."
    },
    "method": {
      "type": "object",
      "description": "How the record was produced: software or algorithm, its version and parameters.",
      "required": [
        "name",
        "version",
        "parameters"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        },
        "parameters": {
          "type": "object"
        },
        "training_data_cutoff": {
          "type": [
            "string",
            "null"
          ],
          "format": "date",
          "description": "For learned models: the latest deposition date in the training data. Used to tell held-out references from training structures."
        }
      }
    },
    "coverage": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "start",
            "end",
            "numbering"
          ],
          "additionalProperties": false,
          "properties": {
            "start": {
              "type": "integer",
              "minimum": 1
            },
            "end": {
              "type": "integer",
              "minimum": 1
            },
            "numbering": {
              "enum": [
                "molecule",
                "author",
                "construct"
              ],
              "description": "molecule: the page's reference sequence (UniProt, RNAcentral). author: the deposited structure's own residue numbers. construct: positions within the construct studied."
            }
          }
        }
      ]
    },
    "representations": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "description": "At least one level of description. Levels are independent; a conformation can be described by secondary structure alone.",
      "properties": {
        "secondary_structure": {
          "type": "object",
          "required": [
            "scheme",
            "string",
            "start"
          ],
          "additionalProperties": false,
          "properties": {
            "scheme": {
              "enum": [
                "dot_bracket",
                "dssp8",
                "dssp3"
              ]
            },
            "string": {
              "type": "string",
              "minLength": 1
            },
            "start": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "segments": {
          "type": "array",
          "minItems": 1,
          "description": "Contiguous stretches with one structural status, in coverage numbering. Folded and unfolded segments are what force spectroscopy resolves.",
          "items": {
            "type": "object",
            "required": [
              "start",
              "end",
              "status"
            ],
            "additionalProperties": false,
            "properties": {
              "start": {
                "type": "integer",
                "minimum": 1
              },
              "end": {
                "type": "integer",
                "minimum": 1
              },
              "status": {
                "enum": [
                  "folded",
                  "unfolded",
                  "paired",
                  "unpaired",
                  "helix",
                  "strand",
                  "coil",
                  "bound",
                  "unobserved"
                ]
              },
              "label": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "contacts": {
          "type": "object",
          "required": [
            "kind",
            "cutoff_nm",
            "pairs"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "base_pairs",
                "residue_contacts"
              ]
            },
            "cutoff_nm": {
              "type": [
                "number",
                "null"
              ]
            },
            "pairs": {
              "type": "array",
              "items": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "integer",
                    "minimum": 1
                  },
                  {
                    "type": "integer",
                    "minimum": 1
                  }
                ],
                "minItems": 2,
                "maxItems": 2
              }
            }
          }
        },
        "coordinates": {
          "type": "object",
          "required": [
            "format",
            "file",
            "pdb_id",
            "model_number",
            "chains",
            "numbering"
          ],
          "additionalProperties": false,
          "properties": {
            "format": {
              "enum": [
                "mmCIF",
                "PDB"
              ]
            },
            "file": {
              "type": [
                "string",
                "null"
              ],
              "description": "Path relative to the site downloads directory, when the coordinates are redistributed."
            },
            "pdb_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "model_number": {
              "type": "integer",
              "minimum": 1
            },
            "chains": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            },
            "numbering": {
              "enum": [
                "molecule",
                "author"
              ]
            }
          }
        },
        "ensemble": {
          "type": "object",
          "required": [
            "members",
            "weighting"
          ],
          "additionalProperties": false,
          "properties": {
            "weighting": {
              "enum": [
                "uniform",
                "population",
                "maximum_entropy",
                "bayesian",
                "clustering"
              ]
            },
            "members": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "conformation_id",
                  "weight"
                ],
                "additionalProperties": false,
                "properties": {
                  "conformation_id": {
                    "type": "string",
                    "pattern": "^CF-[A-Za-z0-9_.-]+$"
                  },
                  "weight": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                }
              }
            }
          }
        }
      }
    },
    "derived": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "quantity",
          "value",
          "unit",
          "method",
          "parameters",
          "assumptions"
        ],
        "additionalProperties": false,
        "properties": {
          "quantity": {
            "enum": [
              "contour_length_released_nm",
              "end_to_end_distance_nm",
              "radius_of_gyration_nm",
              "n_residues",
              "n_structured_residues",
              "n_base_pairs",
              "fraction_helix",
              "fraction_strand"
            ]
          },
          "value": {
            "type": "number"
          },
          "unit": {
            "type": "string"
          },
          "method": {
            "type": "string",
            "minLength": 1
          },
          "parameters": {
            "type": "object"
          },
          "assumptions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "status": {
      "enum": [
        "computed",
        "draft",
        "reviewed"
      ],
      "description": "computed: produced by the pipeline from curated inputs, with no further judgement."
    },
    "provenance": {
      "$ref": "common.schema.json#/$defs/provenance"
    }
  }
}
