{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://conformome.org/schema/mutational_effect.schema.json",
  "title": "Mutational effect",
  "description": "The measured effect of a sequence variant on stability or on a state equilibrium. Large datasets (mega-scale cDNA-display proteolysis, MaveDB scans) are linked by data_link and summarised per residue (scope residue_summary), not copied row by row. ClinVar variants attach through clinvar_id.",
  "type": "object",
  "required": [
    "effect_id",
    "molecule_id",
    "scope",
    "variant",
    "position",
    "quantity",
    "state_pair",
    "method",
    "conditions",
    "data_link",
    "data_level",
    "provenance"
  ],
  "additionalProperties": false,
  "properties": {
    "effect_id": {
      "type": "string",
      "pattern": "^ME-[A-Za-z0-9_.-]+$"
    },
    "molecule_id": {
      "$ref": "common.schema.json#/$defs/molecule_id"
    },
    "scope": {
      "enum": [
        "variant",
        "residue_summary"
      ]
    },
    "variant": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "hgvs",
            "clinvar_id"
          ],
          "additionalProperties": false,
          "properties": {
            "hgvs": {
              "type": "string",
              "pattern": "^[pcgnr]\\.",
              "description": "HGVS notation, for example p.Ala30Pro or n.25G>A."
            },
            "clinvar_id": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^(VCV|RCV)?[0-9]+$"
            }
          }
        }
      ],
      "description": "Null for a residue summary."
    },
    "position": {
      "type": "integer",
      "minimum": 1
    },
    "quantity": {
      "type": "object",
      "required": [
        "type",
        "value",
        "unit",
        "uncertainty",
        "n_variants"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "ddg_folding",
            "ddg_state",
            "delta_tm",
            "functional_score"
          ],
          "description": "ddg_state is the shift of the equilibrium between state_pair; ddg_folding uses the folded and unfolded states."
        },
        "value": {
          "type": "number"
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "uncertainty": {
          "type": [
            "number",
            "null"
          ]
        },
        "summary": {
          "enum": [
            "mean",
            "median",
            "min",
            "max"
          ],
          "description": "How a residue_summary combines its variants."
        },
        "n_variants": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "state_pair": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "from_state",
            "to_state"
          ],
          "additionalProperties": false,
          "properties": {
            "from_state": {
              "$ref": "common.schema.json#/$defs/state_id"
            },
            "to_state": {
              "$ref": "common.schema.json#/$defs/state_id"
            }
          }
        }
      ],
      "description": "The states whose equilibrium the value refers to; null when the source does not say (functional scores)."
    },
    "method": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$",
      "description": "Technique id from taxonomy/techniques.yaml."
    },
    "conditions": {
      "$ref": "common.schema.json#/$defs/conditions"
    },
    "data_link": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri"
    },
    "data_level": {
      "enum": [
        "raw",
        "processed",
        "reported"
      ]
    },
    "provenance": {
      "$ref": "common.schema.json#/$defs/provenance"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "scope": {
            "const": "variant"
          }
        }
      },
      "then": {
        "properties": {
          "variant": {
            "type": "object"
          },
          "quantity": {
            "properties": {
              "n_variants": {
                "const": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "scope": {
            "const": "residue_summary"
          }
        }
      },
      "then": {
        "properties": {
          "variant": {
            "type": "null"
          },
          "quantity": {
            "required": [
              "summary"
            ]
          }
        }
      }
    }
  ]
}
