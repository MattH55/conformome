{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://conformome.org/schema/transition.schema.json",
  "title": "Transition",
  "description": "A directional transition between two states, with a rate or a free-energy difference, the conditions it was measured under, the evidence behind it and, where measured, its kinetics (rate constants, m-values, activation energy, Φ-values).",
  "type": "object",
  "required": [
    "transition_id",
    "molecule_id",
    "from_state",
    "to_state",
    "quantity",
    "conditions",
    "evidence_ids",
    "provenance"
  ],
  "additionalProperties": false,
  "properties": {
    "transition_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "molecule_id": {
      "$ref": "common.schema.json#/$defs/molecule_id"
    },
    "from_state": {
      "$ref": "common.schema.json#/$defs/state_id"
    },
    "to_state": {
      "$ref": "common.schema.json#/$defs/state_id"
    },
    "quantity": {
      "type": "object",
      "required": [
        "type",
        "value",
        "unit",
        "uncertainty"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "rate",
            "delta_g"
          ]
        },
        "value": {
          "type": "number"
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "uncertainty": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "conditions": {
      "$ref": "common.schema.json#/$defs/conditions"
    },
    "evidence_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^EV-[A-Za-z0-9_-]+$"
      }
    },
    "provenance": {
      "$ref": "common.schema.json#/$defs/provenance"
    },
    "kinetics": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "method",
            "forward_rate",
            "reverse_rate",
            "m_value_forward",
            "m_value_reverse",
            "distance_to_transition_state",
            "activation_energy",
            "phi_values"
          ],
          "additionalProperties": false,
          "properties": {
            "method": {
              "enum": [
                "stopped_flow",
                "t_jump",
                "pressure_jump",
                "nmr_dispersion",
                "smfret",
                "force_spectroscopy",
                "hdx",
                "md",
                "other"
              ]
            },
            "forward_rate": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "common.schema.json#/$defs/measured"
                }
              ],
              "description": "from_state -> to_state rate constant (folding rate when to_state is the native state)."
            },
            "reverse_rate": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "common.schema.json#/$defs/measured"
                }
              ],
              "description": "to_state -> from_state rate constant."
            },
            "m_value_forward": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "common.schema.json#/$defs/measured"
                }
              ],
              "description": "Denaturant dependence of ln k forward (kJ mol-1 M-1 or kcal mol-1 M-1)."
            },
            "m_value_reverse": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "common.schema.json#/$defs/measured"
                }
              ]
            },
            "distance_to_transition_state": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "common.schema.json#/$defs/measured"
                }
              ],
              "description": "Force dependence: distance to the transition state along the pulling coordinate (nm)."
            },
            "activation_energy": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "common.schema.json#/$defs/measured"
                }
              ]
            },
            "phi_values": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "common.schema.json#/$defs/profile"
                }
              ],
              "description": "Φ-value per mutated residue (profile kind phi_value); null where not mutated."
            }
          }
        }
      ]
    }
  }
}
