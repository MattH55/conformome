{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://conformome.org/schema/common.schema.json",
  "title": "Shared definitions",
  "$defs": {
    "uniprot": {
      "type": "string",
      "pattern": "^([OPQ][0-9][A-Z0-9]{3}[0-9]|[A-NR-Z][0-9]([A-Z][A-Z0-9]{2}[0-9]){1,2})$",
      "description": "UniProtKB accession (primary, without isoform suffix)."
    },
    "provenance": {
      "type": "object",
      "description": "Where a record came from. Every record carries one.",
      "required": ["source", "retrieved", "url", "licence"],
      "additionalProperties": false,
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "doi": {"type": ["string", "null"]},
        "deposit_id": {"type": ["string", "null"], "description": "PDB ID, BMRB ID, SASBDB code, PRIDE accession, DOI-less dataset ID, etc."},
        "retrieved": {"type": "string", "format": "date"},
        "url": {"type": "string", "format": "uri"},
        "licence": {"type": "string", "minLength": 1, "description": "Licence of the source data, as recorded in docs/SOURCES.md."}
      }
    },
    "conditions": {
      "type": "object",
      "description": "Conditions under which the observation or state was measured. Unknown values are null, never omitted.",
      "required": ["environment", "temperature_c", "ph", "buffer", "salt_mM", "ligands", "applied_force_pn", "notes"],
      "additionalProperties": false,
      "properties": {
        "environment": {"enum": ["in_vitro", "in_cell", "in_silico"]},
        "temperature_c": {"type": ["number", "null"]},
        "ph": {"type": ["number", "null"]},
        "buffer": {"type": ["string", "null"]},
        "salt_mM": {"type": ["number", "null"]},
        "ligands": {"type": "array", "items": {"type": "string"}},
        "applied_force_pn": {"type": ["number", "null"]},
        "notes": {"type": ["string", "null"]}
      }
    },
    "mapping": {
      "type": "object",
      "description": "One link from an evidence item to a state. Who made it, how sure, and why must always be visible.",
      "required": ["state_id", "who", "confidence", "justification"],
      "additionalProperties": false,
      "properties": {
        "state_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"},
        "who": {"type": "string", "pattern": "^(curator|rule):.+$"},
        "confidence": {"enum": ["high", "medium", "low"]},
        "justification": {"type": "string", "minLength": 1},
        "rule": {"type": ["string", "null"]}
      }
    },
    "basis": {
      "enum": ["observed", "inferred"],
      "description": "observed: directly resolved (X-ray, cryo-EM, NMR structure). inferred: fitted to indirect constraints."
    }
  }
}
